/* Built on Textual's theme variables, so the built-in themes all work. */

#topbar {
    height: 1;
    background: $panel;
}

#board {
    height: 1fr;
    overflow-x: auto;
    overflow-y: hidden;
    padding: 1 0 0 0;
}

.column {
    width: 1fr;
    min-width: 30;
    height: 100%;
    margin: 0 1;
}

.column-header {
    height: 1;
    padding: 0 1;
    background: $panel;
    color: $text;
    margin-bottom: 1;
}

.column.active .column-header {
    background: $primary;
}

.column-body {
    height: 1fr;
    scrollbar-size-vertical: 1;
}

.empty {
    padding: 0 2;
}

.card {
    height: auto;
    margin: 0 0 1 0;
    padding: 0 1;
    background: $surface;
    border-left: outer #6c7086;
}
.card.prio-1 { border-left: outer #a6e3a1; }
.card.prio-2 { border-left: outer #f9e2af; }
.card.prio-3 { border-left: outer #fab387; }
.card.prio-4 { border-left: outer #f38ba8; }

.card.done {
    text-opacity: 60%;
}

.card.selected {
    background: $primary 35%;
    text-opacity: 100%;
}

#filter {
    display: none;
    dock: bottom;
    margin-bottom: 1;
}
#filter.open {
    display: block;
}

/* -- dialogs ------------------------------------------------------------ */

ModalScreen {
    align: center middle;
    background: $background 60%;
}

.dialog {
    width: 76;
    max-width: 95%;
    height: auto;
    max-height: 95%;
    overflow-y: auto;
    padding: 1 2;
    background: $surface;
    border: round $primary;
}
.dialog.small {
    width: 60;
}

.dialog-title {
    text-style: bold;
    margin-bottom: 1;
}

.section {
    text-style: bold;
    margin-top: 1;
}

.hint {
    color: $text-muted;
    margin-top: 1;
}

.dialog OptionList {
    height: auto;
    max-height: 14;
}

#description {
    height: 7;
    margin-top: 1;
}

#fields {
    height: auto;
    margin-top: 1;
}
#priority {
    width: 22;
}
#tags {
    width: 1fr;
}

#checklist {
    height: auto;
    min-height: 3;
    max-height: 9;
}
